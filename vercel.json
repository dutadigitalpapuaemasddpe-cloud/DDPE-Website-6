{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "ddpe.my.id" }],
      "destination": "https://www.ddpe.my.id/$1",
      "permanent": true
    },
    {
      "source": "/gabung.html",
      "destination": "/terlibat.html",
      "permanent": true
    },
    {
      "source": "/tulis-berita.html",
      "destination": "/dashboard.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/artikel.html",
      "destination": "/api/article-page"
    },
    {
      "source": "/sitemap-news.xml",
      "destination": "/api/news-sitemap"
    }
  ]
}