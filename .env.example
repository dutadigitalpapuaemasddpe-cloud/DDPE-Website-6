# Salin nilainya ke Vercel Project Settings > Environment Variables.
# Jangan masukkan service-role key ke HTML, JavaScript browser, atau Git.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SET_ONLY_IN_VERCEL_SERVER_ENVIRONMENT
DDPE_RATE_LIMIT_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_BYTES
DDPE_PUBLIC_MEDIA_BUCKET=ddpe-media
RESEND_API_KEY=SET_ONLY_IN_VERCEL_SERVER_ENVIRONMENT
DDPE_NOTIFICATION_FROM="DDPE Notifications <noreply@YOUR_VERIFIED_DOMAIN>"
DDPE_NOTIFICATION_TO=dutadigitalpapuaemasddpe@gmail.com